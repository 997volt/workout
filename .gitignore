# ---- Gradle ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ---- Local Android toolchain (JDK + SDK + Gradle caches) ----
# Installed per-machine by tools/android-env.sh; never committed.
.toolchain/

# ---- Secrets: NEVER commit these ----
local.properties
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties
.env

# ---- Android Studio / IntelliJ ----
.idea/
*.iml
captures/
.navigation/

# ---- Android NDK / native ----
.externalNativeBuild/
.cxx/

# ---- Build outputs ----
*.apk
*.aab
*.ap_
*.dex
*.class
output.json
release/

# ---- Kotlin ----
.kotlin/

# ---- Logs / OS cruft ----
*.log
.DS_Store
Thumbs.db

# ---- Python ----
# `tools/` holds two Python gates (run from CI); their bytecode is a build artifact like
# any other, and an accidental `__pycache__` commit is invisible until someone reads the diff.
__pycache__/
*.pyc

# ---- Generated data: kept locally, never committed ----
# Built from the training spreadsheet; imported into the app by hand.
Gym-2026-M6-backup.json
store/test-plan-program.json
