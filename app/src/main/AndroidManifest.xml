<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      **No permissions at all** (ROADMAP N26). This file declared POST_NOTIFICATIONS and
      SCHEDULE_EXACT_ALARM for the background rest alert; the alert was removed and they went with it.
      An empty permission list is a stronger statement about health data than any wording, so the
      two comments that used to explain them are gone rather than left to mislead — see README.md.
    -->

    <!--
      Workout history is health data, so it must not leave the device through
      the platform's backup or transfer mechanisms.

      allowBackup="false" only covers cloud backup. Device-to-device transfer
      is governed separately by dataExtractionRules, and is fully enabled when
      that file has no <device-transfer> section. Both are excluded there.
      See app/src/main/res/xml/data_extraction_rules.xml
    -->
    <application
        android:name=".AndroidApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AndroidApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          A content URI over one cache directory, and nothing else (ROADMAP B158, B159): the instrumented test of
          `DocumentIo` writes and reads a real document, which needs a provider the app itself can hand out. The
          app has no reason to share a file with another app — the export is a user-chosen destination through the
          Storage Access Framework — so this grants no path beyond [file_paths.xml](res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
