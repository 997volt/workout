<?xml version="1.0" encoding="utf-8"?>
<!--
  Extraction rules for Android 12+ (API 31+), used when the app targets 31+.

  Why this file exists even though android:allowBackup is already "false":
  android:allowBackup="false" disables *cloud* backup, but on Android 12+ a
  missing <device-transfer> section leaves device-to-device transfer FULLY
  ENABLED. Workout history and body measurements are health data, so both
  modes are excluded explicitly.

  https://developer.android.com/identity/data/autobackup

  Export/import has landed (ROADMAP P1.12); platform transfer stays off because
  the export and the optional automatic-backup folder are the paths we control,
  rather than re-enabling transfer here.
-->
<data-extraction-rules>

    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>

    <!--
      Android-to-iOS transfer. Health data must not follow the user onto a
      platform where we cannot enforce our own privacy policy.
    -->
    <cross-platform-transfer platform="ios">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cross-platform-transfer>

</data-extraction-rules>
